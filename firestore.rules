rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lectura publica para todas las colecciones
    match /{document=**} {
      allow read: if true;
    }

    // Perfil de usuario — solo el propio usuario puede escribir/actualizar
    match /usuarios/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Checkout sessions
    match /usuarios/{uid}/checkout_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Colecciones de contenido — escritura para admins autenticados
    match /examenes/{docId} {
      allow write: if request.auth != null;
    }
    match /examenes/{docId}/temas_config/{configId} {
      allow write: if request.auth != null;
    }
    match /materias/{docId} {
      allow write: if request.auth != null;
    }
    match /temas/{docId} {
      allow write: if request.auth != null;
    }
    match /preguntas/{docId} {
      allow write: if request.auth != null;
    }
    match /configuracion/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
