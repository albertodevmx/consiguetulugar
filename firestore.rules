rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lectura publica para todas las colecciones
    match /{document=**} {
      allow read: if true;
    }

    // Perfil de usuario — solo el propio usuario puede escribir/actualizar
    match /usuarios/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Checkout sessions — el usuario puede crear y leer sus propias sesiones
    match /usuarios/{uid}/checkout_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Escritura solo para admins autenticados
    match /schools/{docId} {
      allow write: if request.auth != null;
    }
    match /examTypes/{docId} {
      allow write: if request.auth != null;
    }
    match /subjects/{docId} {
      allow write: if request.auth != null;
    }
    match /units/{docId} {
      allow write: if request.auth != null;
    }
    match /topics/{docId} {
      allow write: if request.auth != null;
    }
    match /schoolExamTypes/{docId} {
      allow write: if request.auth != null;
    }
    match /examTypeSubjects/{docId} {
      allow write: if request.auth != null;
    }
    match /subjectUnits/{docId} {
      allow write: if request.auth != null;
    }
    match /unitTopics/{docId} {
      allow write: if request.auth != null;
    }
    match /questions/{docId} {
      allow write: if request.auth != null;
    }
    match /examenes/{docId} {
      allow write: if request.auth != null;
    }
    match /examenes/{docId}/materias_mapping/{mapId} {
      allow write: if request.auth != null;
    }
    match /materias/{docId} {
      allow write: if request.auth != null;
    }
    match /preguntas/{docId} {
      allow write: if request.auth != null;
    }
  }
}
